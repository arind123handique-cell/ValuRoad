rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Projects ────────────────────────────────────────────────────
    // Any authenticated user can create projects.
    // Owners can read/write/delete their own projects.
    // Shared users (in sharedWith array) can read and update.
    match /projects/{projectId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      // Entries subcollection — authenticated users can read/write
      match /entries/{entryId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Users (private per-user data) ───────────────────────────────
    // Users can only access their own data, including all subcollections
    // (settings/dsr_catalog, settings/pdf_template, projects/*)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Global Community DSR Catalog ────────────────────────────────
    // Any authenticated user can read and contribute items
    match /global_dsr_items/{itemId} {
      allow read, write: if request.auth != null;
    }

    // ── Other collections (from original rules) ─────────────────────
    match /approvals/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /documents/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /surveys/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /valuation_items/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /villages/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    // ── FlutterFlow admin access ────────────────────────────────────
    match /{document=**} {
      allow read, write: if request.auth.token.email.matches("firebase@flutterflow.io");
    }
  }
}
